# Copy this file's contents into the "Secrets" box in Streamlit Community Cloud's
# app settings (Settings -> Secrets). Never commit a real secrets.toml to GitHub --
# it's in .gitignore for that reason.

APP_PASSWORD = "choose-a-password-to-share-with-friends"
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-4-6"
MAX_OUTPUT_TOKENS = 16000

# Optional: sheet name to log runs to (only used if gcp_service_account is set below)
LOG_SHEET_NAME = "AI Writers Room Logs"

# Optional: only needed if you want run logging to a Google Sheet (see PORTING_GUIDE.md
# / README_DEPLOY.md for how to create this). Delete this whole section to skip logging.
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
